# Experiment data (code, results_*.json, history JSONs stay tracked)
/experiments/*landmarks*/
/experiments/checkpoints/*.h5
/experiments/*.pkl
/experiments/*.log

# Datasets are fetched by the user, never redistributed (see experiments/README.md)
/data/

# Private research working files. These are deliberately NOT published:
# RESEARCH.md is the personal results/backlog log, and rmd/overleaf/ is the
# LaTeX source whose figures live only in Overleaf (it cannot build here).
# Git does not back these up — keep your own copies.
/rmd/RESEARCH.md
/rmd/overleaf/

# npm lockfile — this project uses yarn; having both desyncs resolution
package-lock.json

